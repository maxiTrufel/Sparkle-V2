PORT=3000

# MySQL / MariaDB (ej. XAMPP local). "npm run init-db" crea la base y las
# tablas usando estos mismos valores — ver backend/README.md.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=sparkle_v2

# ID(s) de la extensión de Chrome autorizados a llamar al backend desde su
# service worker (origen chrome-extension://<id>). Se ve en chrome://extensions
# con el "Modo de desarrollador" activado. Cambia si la extensión se recarga
# en otra carpeta/máquina — hay que actualizar este valor en cada entorno de
# prueba. Admite una lista separada por comas para más de una instalación.
ALLOWED_EXTENSION_IDS=

# Clave compartida con la extensión (§7 del plan de despliegue, opción B).
# Es el ÚNICO control de acceso real de la API: la whitelist de
# ALLOWED_EXTENSION_IDS de arriba es CORS, y CORS solo frena navegadores —
# un `curl` no manda header `Origin` y pasa igual.
#
# La extensión la manda como header `X-Sparkle-Key` en cada request y como
# query string `?key=` en el handshake del WebSocket (la API `WebSocket` del
# navegador no permite headers propios). Tiene que coincidir EXACTAMENTE con
# `VITE_SPARKLE_API_KEY` de frontend/.env, que se hornea en el build.
#
# VACÍA DEJA LA API ABIERTA. Es a propósito, para que el desarrollo local y
# los tests anden sin configurar nada; en producción es un agujero, y el
# backend lo avisa por consola al arrancar.
#
# Qué frena y qué no: frena el escaneo desde afuera y a cualquiera que no se
# tome el trabajo de descomprimir la extensión, porque la clave viaja en el
# bundle en texto plano. NO es autenticación de verdad — para eso hace falta
# un token de sesión por reunión (opción C de §7).
#
# Generar con: openssl rand -hex 32
SPARKLE_API_KEY=

# Vexa (servicio self-hosted de transcripción de Google Meet) — ver
# backend/src/services/vexaService.js. Las keys son secretas: no pongas acá
# los valores reales, solo en backend/.env (gitignorado).
VEXA_API_URL=http://localhost:8056
VEXA_BOT_API_KEY=
VEXA_TX_API_KEY=

# OpenAI — resumen con IA del material de la clase (PDF) al cargarlo, ver
# backend/src/providers/openAIDocumentAnalysisProvider.js. La key es
# secreta: no pongas acá el valor real, solo en backend/.env (gitignorado).
# OPENAI_SUMMARY_MODEL tiene default 'gpt-4o-mini' (económico) en el código
# si se deja vacío — solo hace falta setearlo acá para usar otro modelo.
# OPENAI_SUMMARY_MAX_CHARS tiene default 40000 — cuántos caracteres del
# texto extraído se mandan como máximo a OpenAI (se trunca el resto, con
# un log si eso pasa), para no gastar tokens de más en documentos largos.
#
# El resumen con IA está DESACTIVADO por defecto (ver
# backend/src/providers/index.js) — mientras ENABLE_AI_DOCUMENT_ANALYSIS no
# esté en 'true', el proveedor activo solo extrae el texto plano del PDF
# (`PdfTextExtractionProvider`), sin llamar a OpenAI ni necesitar
# OPENAI_API_KEY.
ENABLE_AI_DOCUMENT_ANALYSIS=true
OPENAI_API_KEY=
OPENAI_SUMMARY_MODEL=gpt-4o-mini
OPENAI_SUMMARY_MAX_CHARS=40000

# OpenAI — generación de preguntas de comprensión EN VIVO durante la clase
# ("Generar pregunta"), ver backend/src/providers/openAIQuestionProvider.js
# y backend/src/services/questionService.generatePreview. Reusa la misma
# OPENAI_API_KEY de arriba. OPENAI_QUESTION_MODEL tiene default
# 'gpt-4o-mini' (económico) si se deja vacío — esto corre muchas veces por
# clase, es donde más importa mantener el costo bajo.
# AI_QUESTION_TRANSCRIPT_FRAGMENTS tiene default 40 — cuántos de los
# últimos fragmentos de transcripción se le pasan como contexto (ver
# backend/src/repositories/transcriptRepository.js#getRecentSegments).
#
# Desactivada por defecto — mientras ENABLE_AI_QUESTION_GENERATION no esté
# en 'true', "Generar pregunta" sigue eligiendo del banco fijo local
# (`RandomQuestionProvider`), sin llamar a OpenAI.
ENABLE_AI_QUESTION_GENERATION=true
OPENAI_QUESTION_MODEL=gpt-4o-mini
AI_QUESTION_TRANSCRIPT_FRAGMENTS=40

# OpenAI — resumen de la clase para el ALUMNO ("Obtener resumen de la
# clase"), ver backend/src/providers/openAIClassSummaryProvider.js y
# backend/src/services/classSummaryService.js. Reusa la misma
# OPENAI_API_KEY de arriba. OPENAI_CLASS_SUMMARY_MODEL tiene default
# 'gpt-4o-mini' si se deja vacío.
# OPENAI_CLASS_SUMMARY_MAX_CHARS tiene default 60000 — cuántos caracteres
# de la TRANSCRIPCIÓN COMPLETA de la clase se mandan como máximo (se
# trunca el resto — el INICIO de la transcripción, no el final — con un
# log si eso pasa).
# OPENAI_CLASS_SUMMARY_MIN_CHARS tiene default 500 — por debajo de esta
# cantidad de caracteres TOTALES de transcripción, ni se llama a OpenAI:
# con tan poco contenido real dicho en la clase, no hay nada que resumir
# (se muestra igual "Para repasar", con un mensaje neutral en el resumen).
# Evita pagar una llamada que predeciblemente devolvería un resumen vacío.
#
# Mientras ENABLE_AI_CLASS_SUMMARY no esté en 'true', el botón del alumno
# sigue mostrando la sección "Para repasar" (preguntas mal respondidas o
# no respondidas) sin ninguna llamada a IA, con un mensaje neutral en vez
# de la parte con IA — nunca un error. El resultado del resumen con IA se
# cachea por reunión (en memoria, sin TTL): como mucho UNA llamada a
# OpenAI por clase, sin importar cuántos alumnos aprieten el botón.
ENABLE_AI_CLASS_SUMMARY=true
OPENAI_CLASS_SUMMARY_MODEL=gpt-4o-mini
OPENAI_CLASS_SUMMARY_MAX_CHARS=60000
OPENAI_CLASS_SUMMARY_MIN_CHARS=500

# OpenAI — "Recuperar contenido" (alumno, botón de la alerta de fatiga por
# desatención, ver backend/src/providers/openAIRecoverySummaryProvider.js
# y backend/src/services/recoverySummaryService.js). Reusa la misma
# OPENAI_API_KEY de arriba. A diferencia del resumen de clase (una sola
# llamada por reunión, cacheada), esto corre una vez POR CADA CLICK de
# CADA alumno — el modelo económico importa más acá, no menos.
# OPENAI_RECOVERY_SUMMARY_MODEL tiene default 'gpt-4o-mini' si se deja
# vacío. OPENAI_RECOVERY_SUMMARY_MAX_CHARS tiene default 8000 (la ventana
# resumida es de solo 2-3 minutos, así que en la práctica casi nunca se
# acerca a este tope). OPENAI_RECOVERY_SUMMARY_MIN_CHARS tiene default 25
# — decide si la transcripción de la ventana reciente cuenta como una
# fuente válida. Ya no es el único piso: se llama a OpenAI si HAY
# transcripción suficiente (esto) O si hay info útil del análisis del
# documento del docente (mainTopics/keyConcepts) — alcanza con cualquiera
# de las dos. Solo si NINGUNA de las dos tiene contenido se corta antes de
# llamar a OpenAI (devuelve "insufficient_content" directo).
#
# Mientras RECOVERY_SUMMARY_ENABLED no esté en 'true', "Recuperar
# contenido" muestra un mensaje neutral ("no disponible por ahora") en vez
# de un resumen, sin llamar a OpenAI.
RECOVERY_SUMMARY_ENABLED=true
OPENAI_RECOVERY_SUMMARY_MODEL=gpt-4o-mini
OPENAI_RECOVERY_SUMMARY_MAX_CHARS=8000
OPENAI_RECOVERY_SUMMARY_MIN_CHARS=25

# OpenAI — análisis pedagógico con IA del reporte PDF de fin de clase
# (botón "Descargar reporte" del docente, Sección 5 del reporte), ver
# backend/src/providers/openAIClassReportProvider.js y
# backend/src/services/classReportService.js. Reusa la misma
# OPENAI_API_KEY de arriba. OPENAI_CLASS_REPORT_MODEL tiene default
# 'gpt-4o-mini' si se deja vacío — corre como mucho una vez por reunión
# (resultado cacheado en memoria, sin TTL, igual que el resumen de clase).
#
# Mientras ENABLE_AI_CLASS_REPORT no esté en 'true', el reporte se genera
# igual (ranking, análisis de preguntas, salteos, atención) pero la
# Sección 5 (fortalezas/debilidades/recomendaciones con IA) queda marcada
# como no disponible, sin llamar a OpenAI.
ENABLE_AI_CLASS_REPORT=true
OPENAI_CLASS_REPORT_MODEL=gpt-4o-mini
