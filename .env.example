# Variables que consume docker-compose.yml (NO las de la aplicación —
# esas viven en backend/.env, ver backend/.env.example).
#
# Copiar a `.env` en esta misma carpeta y completar. El `.env` real está
# gitignorado; los valores van al gestor de contraseñas (paso 3.12).

# Dominio del servidor de aplicación. Caddy pide el certificado de Let's
# Encrypt para este nombre, así que el registro A del DNS ya tiene que
# apuntar al servidor (paso 5.1) ANTES de levantar el stack.
DOMAIN=

# Credenciales de MariaDB. Generar con: openssl rand -hex 32 (paso 3.6).
#
# DB_USER es el usuario de la aplicación, sin privilegios sobre el resto
# del servidor. La root se usa solo para administración manual — el
# backend nunca la ve.
DB_ROOT_PASSWORD=
DB_USER=sparkle
DB_PASSWORD=
DB_NAME=sparkle_v2
